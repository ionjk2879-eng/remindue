<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- android:icon(@mipmap/ic_launcher)은 불투명 풀컬러라 FCM이 상태바 아이콘으로 그대로
             쓰면 알파 채널이 없어 그냥 흰 사각형/얼룩으로만 보인다(Android가 상태바 아이콘은
             항상 단색 실루엣으로 강제 렌더링하기 때문 — workers/src/lib/fcm.ts 참고). 그래서
             public/notification-*.png의 시계 모양에서 뽑아낸 흰색 실루엣 전용 리소스를
             기본 알림 아이콘으로 지정한다. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />

        <!-- @capacitor/push-notifications가 기본 제공하는 MessagingService는 알림 액션 버튼을
             그릴 수 없다(RemindueMessagingService.java 참고) — FCM은 앱당 MessagingService를
             하나만 허용하므로, 기본 서비스를 제거하고 우리 것으로 교체한다. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".RemindueMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 알림의 "유지하기"/"모두 유지" 같은 액션 버튼 클릭을 앱을 열지 않고 처리한다. -->
        <receiver
            android:name=".PushActionReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
